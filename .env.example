# =====================================================
# knowhow 环境配置示例（复制为 .env 并按生产修改；.env 不入库）
# =====================================================

# ---------- 数据库（必改：生产禁止使用开发密码） ----------
RAG_DSN=postgresql://rag:rag_dev_2026@localhost:5433/rag

# ---------- 密钥（必改：任意随机字符串，如 openssl rand -base64 32） ----------
KNOWHOW_SECRET=

# ---------- 会话 ----------
SESSION_TTL_HOURS=24
SESSION_MAX_HOURS=72
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=10

# ---------- 生产模式 ----------
# KNOWHOW_PROD=1   # 生产：禁用默认密码演示提示，强制首次登录改密
SEED_PASSWORDS=   # 格式: u_admin=强密码,u_reviewer=xxx,u_editor=xxx,u_agent=xxx

# ---------- 服务 ----------
APP_HOST=0.0.0.0
APP_PORT=8000
MAX_UPLOAD_MB=50

# ---------- 模型 ----------
# EMBEDDING_MODEL=bge-m3        # bge-m3 | qwen3-embedding-0.6b
